# Copiá este archivo como .env (en la raíz del proyecto) y completá los valores.
# El .env no se sube a Git. Lo leen el backend (Spring) y docker compose.
# Sin comillas alrededor de los valores.

# Clave para firmar los JWT: mínimo 32 caracteres, distinta en cada máquina.
WOPFIT_JWT_SECRET=

# Contraseña del usuario "wopfit" de MySQL. Si ya tenías el volumen de Docker creado, poné la que usaba (wopfit).
DB_PASSWORD=

# Key de Google Places API (New), para los lugares reales de "Cerca tuyo". Es secreta: solo la usa el backend.
# Si la dejás vacía, se muestran solo los aliados de la demo.
GOOGLE_PLACES_KEY=
