# Copiá este archivo como frontend/.env.local (no se sube a Git) y completá los valores.
# Todo lo que empieza con VITE_ queda adentro del JavaScript que baja el navegador: acá no va nada secreto.

# Key de Maps JavaScript API. Es pública por diseño: protegela en Google Cloud restringiéndola a
# http://localhost:5173/* y al dominio de Vercel, y solo a "Maps JavaScript API".
VITE_GOOGLE_MAPS_KEY=

# Map ID de Google Cloud (hace falta para los pines propios). Vacío usa DEMO_MAP_ID, el de prueba de Google.
VITE_GOOGLE_MAP_ID=
